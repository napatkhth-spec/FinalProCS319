{
  "name": "local-farmer-market",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c green,blue \"npm:dev:frontend\" \"npm:dev:backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "format": "prettier --write \"backend/**/*.{ts,tsx,js,mjs,cjs,json}\" \"frontend/**/*.{ts,tsx,js,mjs,cjs,json}\" \"*.json\"",
    "format:check": "prettier --check \"backend/**/*.{ts,tsx,js,mjs,cjs,json}\" \"frontend/**/*.{ts,tsx,js,mjs,cjs,json}\" \"*.json\"",
    "build": "npm run build --workspace frontend && npm run build --workspace backend",
    "typecheck": "npm run typecheck --workspace frontend && npm run typecheck --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.10.1"
  },
  "allowScripts": {
    "argon2@0.45.2": true
  }
}
