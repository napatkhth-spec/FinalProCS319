{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/tests/auth.test.ts src/tests/auth-api.test.ts src/tests/product-query.test.ts src/tests/product-image-validation.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:seed": "prisma db seed --config prisma7.config.ts",
    "images:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-seed-product-images.ps1",
    "images:import": "tsx scripts/import-seed-product-images.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "argon2": "^0.45.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "jose": "^6.2.18",
    "multer": "^2.5.0",
    "pg": "^8.16.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "prisma": "^7.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  }
}
