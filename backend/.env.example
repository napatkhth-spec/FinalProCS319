PORT=3000
# Comma-separated exact origins, for example localhost for development and your deployed frontend origin.
FRONTEND_URL=http://localhost:5173

# Generate separate random values; never store these in PostgreSQL.
NATIONAL_ID_ENCRYPTION_KEY=
NATIONAL_ID_HASH_SECRET=
DATABASE_URL=
DIRECT_URL=
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_ISSUER=local-farmer-market-api
ACCESS_TOKEN_AUDIENCE=local-farmer-market-web
ACCESS_TOKEN_TTL_SECONDS=3600
# Server-side Supabase Storage only. Never place SUPABASE_SECRET_KEY in a VITE_ variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_COOKIE_NAME=lfm_refresh
AUTH_COOKIE_SAME_SITE=lax
# Set true in production and serve over HTTPS.
AUTH_COOKIE_SECURE=false
